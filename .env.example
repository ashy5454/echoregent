# CTS — Environment Variables
# Copy this file to .env and fill in your values

# LLM provider for demo/fallback responses (optional)
# Supports any OpenAI-compatible key
DEMO_LLM_API_KEY=your_api_key_here
DEMO_LLM_MODEL=gemini-3.5-flash

# Gemini API key (if using Gemini as LLM provider)
GEMINI_API_KEY=your_gemini_key_here

# Admin secret for the /admin/* endpoints
# Generate a strong random string: openssl rand -hex 32
CTS_ADMIN_SECRET=change_me_to_a_strong_secret

# Set true only when ml/cts_classifier is deployed and local ONNX inference is
# mandatory. The default keeps rule-based fallbacks healthy and deployable.
CTS_REQUIRE_LOCAL_MODELS=false

# Optional browser origin. Leave blank in production when the API is
# server-to-server or served from the same origin.
CTS_CORS_ORIGIN=

# Optional: CTS hosted API (for managed tier)
# Leave blank to run fully local
CTS_API_URL=
CTS_API_KEY=
