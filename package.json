{
  "name": "echoregent",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "tsx src/server.ts",
    "api": "tsx src/server.ts",
    "build": "vite build && tsc --noEmit false --outDir dist",
    "eval:convert": "tsx src/evals/convertLegacyDataset.ts",
    "eval:dataset": "tsx src/evals/datasetEval.ts",
    "eval:tokens": "tsx src/evals/tokenEval.ts",
    "eval:session-memory": "tsx src/evals/sessionMemoryEval.ts",
    "eval:plugins": "tsx src/evals/pluginEval.ts",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-legacy": "^5.4.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "firebase-admin": "^14.0.0",
    "firebase-functions": "^7.2.5",
    "pg": "^8.20.0",
    "resend": "^6.12.3",
    "tsx": "^4.19.2"
  }
}
